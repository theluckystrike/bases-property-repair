{
 "slug": "bases-property-repair",
 "module": "bases-property-repair/src/repair",
 "function": "planBase",
 "note": "planBase: args = [path, base file text, rename map {old: new}]; expected = status, reason or reasonStartsWith, result (the parsed YAML of the new text), changes as [where, before, after], notes as kinds. rewriteExpression (src/expr): args = [expression, map]; expected = text, changed, skipped, note kinds. applyScenario: args = [vault files {path: text}, map, edits made after the preview {path: text}]; it plans each .base file outside Restore, applies the edits, then applyPlans with every plan checked, folder Restore and stamp 2026-10-13 101500; expected = results as [path, status, copy] and the vault files after. validateMap: args = [pairs]; expected = problem sentences.",
 "cases": [
  {
   "name": "AC1 filter note.status == \"done\" becomes note.state == \"done\"",
   "function": "planBase",
   "args": [
    "Tasks.base",
    "filters:\n  and:\n    - note.status == \"done\"\n",
    {
     "status": "state"
    }
   ],
   "expected": {
    "status": "change",
    "result": {
     "filters": {
      "and": [
       "note.state == \"done\""
      ]
     }
    },
    "changes": [
     [
      "filters.and[0]",
      "note.status == \"done\"",
      "note.state == \"done\""
     ]
    ],
    "notes": []
   }
  },
  {
   "name": "AC2 the string \"status\" stays unchanged",
   "function": "rewriteExpression",
   "args": [
    "status == \"status\"",
    {
     "status": "state"
    }
   ],
   "expected": {
    "text": "state == \"status\"",
    "changed": 1,
    "skipped": false,
    "notes": []
   }
  },
  {
   "name": "AC3 only note[\"status\"] changes, formula.status and file.status stay",
   "function": "rewriteExpression",
   "args": [
    "note[\"status\"] + formula.status + file.status",
    {
     "status": "state"
    }
   ],
   "expected": {
    "text": "note[\"state\"] + formula.status + file.status",
    "changed": 1,
    "skipped": false,
    "notes": []
   }
  },
